{
  "sleep-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$(git rev-parse --show-toplevel)/.agents/hooks/sleep_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
