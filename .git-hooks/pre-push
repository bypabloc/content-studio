#!/usr/bin/env bash
#
# pre-push - content-studio (adaptado de klinikae)
#
# Nunca push ni borrado de main o dev (todo entra por PR); el destino tiene que ser una rama de trabajo.
# Los rulesets de GitHub ya lo rechazan: esto avisa antes de esperar al remoto.
# Además, falla si quedan tests tdd efímeros versionados (tests/tdd/).

set -euo pipefail

PREFIJOS='feature|fix|refactor|docs|test|chore|ci|perf|style|experiment|release'
CERO=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  destino="${remote_ref#refs/heads/}"
  case "$destino" in
    main|dev)
      echo "[pre-push] Push o borrado directo de '$destino' prohibido: entra por pull request." >&2
      exit 1
      ;;
  esac
  if [ "$local_sha" != "$CERO" ] && ! [[ "$destino" =~ ^($PREFIJOS)/[a-z0-9][a-z0-9-]*$ ]]; then
    echo "[pre-push] '$destino' no es una rama de trabajo válida (prefijos: ${PREFIJOS//|/, })." >&2
    exit 1
  fi
done

# Tests tdd efímeros (testing.md): se convierten en permanentes o se borran antes del push.
cd "$(git rev-parse --show-toplevel)"
TDD="$(git ls-files 'tests/tdd/*.py')"
if [ -n "$TDD" ]; then
  echo "[pre-push] Quedan tests tdd efímeros; conviértelos en tests de su área o bórralos:" >&2
  echo "$TDD" >&2
  exit 1
fi
