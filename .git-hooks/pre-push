#!/usr/bin/env bash
#
# pre-push - content-studio (adaptado de klinikae)
#
# Nunca push ni borrado de main o dev (todo entra por PR); el destino tiene que ser una rama de trabajo.
# Los rulesets de GitHub ya lo rechazan: esto avisa antes de esperar al remoto.
# Después, test-runner sobre lo que sube (spec 003, D-6): guard-tdd (no quedan tests efímeros en tdd/), typecheck, unit
# (pytest completo con cobertura y espejo) y tdd sobre el changeset `unmerged`; si cambia client/ o tests/e2e/, también
# budget, e2e y tauri-check. Es lo que corría la CI (calidad.yml), que ya no corre en los PR de bypabloc.
# Los tests de hooks hacen push: CS_PRE_PUSH_INNER evita que ese push interno vuelva a correr unit y se recursaría.

set -euo pipefail
HOOKS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

PREFIXES='feature|fix|refactor|docs|test|chore|ci|perf|style|experiment|release'
ZERO=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  target="${remote_ref#refs/heads/}"
  case "$target" in
    main|dev)
      echo "[pre-push] Direct push or delete of '$target' is forbidden: it must go through a pull request." >&2
      exit 1
      ;;
  esac
  if [ "$local_sha" != "$ZERO" ] && ! [[ "$target" =~ ^($PREFIXES)/[a-z0-9][a-z0-9-]*$ ]]; then
    echo "[pre-push] '$target' is not a valid work branch (prefixes: ${PREFIXES//|/, })." >&2
    exit 1
  fi
done

cd "$(git rev-parse --show-toplevel)"
STAGES='guard-tdd,typecheck'
if [ -z "${CS_PRE_PUSH_INNER:-}" ]; then
  STAGES="$STAGES,unit,tdd"
  BASE="$(git merge-base origin/dev HEAD 2>/dev/null || true)"
  if [ -n "$BASE" ] && git diff --name-only "$BASE" HEAD | grep -Eq '^(client|tests/e2e)/'; then
    STAGES="$STAGES,budget,e2e,tauri-check"
  fi
fi
echo "[pre-push] test-runner: ${STAGES//,/, } (unmerged)"
CS_PRE_PUSH_INNER=1 PYTHONPATH="$HOOKS_ROOT" uv run --no-project python -m devtools test-runner --type="$STAGES" --git-mode=unmerged
